{
  "repository": "https://github.com/eng-Islam-Mohamed/Portfolio",
  "license": "MIT",
  "scripts": {
    "install:all": "npm install && npm --prefix inner-site install",
    "postinstall": "npm --prefix inner-site install",
    "build:room": "webpack --config ./bundler/webpack.prod.js --stats errors-warnings",
    "build:desktop": "npm --prefix inner-site run build",
    "build": "npm run build:room && npm run build:desktop && node scripts/copy-inner.cjs",
    "start": "node --env-file-if-exists=.env server/index.cjs",
    "dev": "node scripts/dev.cjs",
    "typecheck": "tsc --project src/tsconfig.json --noEmit && npm --prefix inner-site run typecheck"
  },
  "dependencies": {
    "@babel/core": "^7.16.12",
    "@babel/preset-env": "^7.16.11",
    "@babel/preset-react": "^7.16.7",
    "@tweenjs/tween.js": "^18.6.4",
    "@types/tweenjs": "^1.0.4",
    "babel-loader": "^8.2.3",
    "bezier-easing": "^2.1.0",
    "camera-controls": "^1.34.2",
    "clean-webpack-plugin": "^4.0.0",
    "compression": "^1.7.4",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^6.5.1",
    "express": "^5.1.0",
    "file-loader": "^6.2.0",
    "framer-motion": "^6.3.1",
    "glslify": "^7.1.1",
    "glslify-import-loader": "^0.1.2",
    "glslify-loader": "^2.0.0",
    "gsap": "^3.9.1",
    "html-loader": "^3.1.0",
    "html-webpack-plugin": "^5.5.0",
    "lil-gui": "^0.16.0",
    "mini-css-extract-plugin": "^2.5.3",
    "raw-loader": "^4.0.2",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "stats.js": "^0.17.0",
    "style-loader": "^3.3.1",
    "three": "^0.137.5",
    "ts-loader": "^9.2.8",
    "typescript": "^4.9.5",
    "webpack": "^5.68.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^6.0.0",
    "webpack-merge": "^5.8.0"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.16.7",
    "@types/react": "^17.0.43",
    "@types/react-dom": "^17.0.14",
    "@types/stats.js": "^0.17.0",
    "@types/three": "^0.138.0"
  },
  "name": "mohamed-islam-portfolio",
  "private": true
}
