{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --ignore-scripts && npm --prefix inner-site ci --ignore-scripts",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/contact.js": {
      "memory": 256,
      "maxDuration": 10
    }
  },
  "routes": [
    { "handle": "filesystem" },
    { "src": "/os(?:/.*)?", "dest": "/os/index.html" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
